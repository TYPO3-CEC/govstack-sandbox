      }
      partialRootPaths {
          100 = EXT:sitepackage/Resources/Private/Templates/Extensions/IndexedSearch/
      }
      layoutRootPaths {
          100 = EXT:sitepackage/Resources/Private/Templates/Extensions/IndexedSearch/
      }
  }
