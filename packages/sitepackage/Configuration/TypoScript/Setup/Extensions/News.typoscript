plugin.tx_news {
	mvc.callDefaultActionIfActionCantBeResolved = 1

	view {
		templateRootPaths {
			10 = EXT:sitepackage/Resources/Private/Templates/Extensions/News/
		}

		partialRootPaths {
			10 = EXT:sitepackage/Resources/Private/Partials/Extensions/News/
		}

		layoutRootPaths {
			10 = EXT:sitepackage/Resources/Private/Layouts/Extensions/News/
		}
	}
	settings {
	  cssFile =
    displayDummyIfNoMedia = 0
    list {
      media {
        image {
          maxHeight = 400
          maxWidth = 500
          width =  500
        }
      }
    }
  }
}

